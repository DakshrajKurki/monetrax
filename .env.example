# Monetrax Environment Configuration

# Gemini AI API Configuration
# Add your Gemini API Key below. If omitted, Monetrax operates in offline simulated AI mode.
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001

# Google Maps JavaScript API Configuration (Optional)
# If omitted or invalid, Monetrax seamlessly falls back to MapLibre GL with free dark CartoDB & Esri World Imagery tiles.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAP_ID=monetrax_dark_vector
